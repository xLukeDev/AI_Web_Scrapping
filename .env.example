# Skopiuj ten plik jako .env (Bun i plik .exe wczytują go automatycznie)

# Klucz z https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model dla `scrape` (identyfikator z https://openrouter.ai/models)
MODEL=anthropic/claude-haiku-5.5

# Modele do porównania w `bench` (oddzielone przecinkami)
BENCH_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,google/gemini-2.5-flash-lite,openai/gpt-5.6-luna

# Ile razy powtórzyć pomiar każdego modelu (1–10, wynik jest uśredniany)
BENCH_RUNS=1

# Strona do pobrania i fragment HTML, który trafia do modelu
TARGET_URL=https://books.toscrape.com/
ROOT_SELECTOR=section
